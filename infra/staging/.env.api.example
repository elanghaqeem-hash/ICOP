# Staging-only template. Copy to .env.api; chmod 600. NEVER commit credentials.
# docker compose --env-file infra/staging/.env.api -f docker-compose.cloudflare-free-staging.yml ...
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
DB_HOST=postgres
DB_PORT=5432
DB_NAME=icop_staging
DB_USER=icop_stage
DB_PASSWORD=REPLACE_RANDOM_HEX_48_OR_MORE
DATABASE_URL=postgres://icop_stage:REPLACE_RANDOM_HEX_48_OR_MORE@postgres:5432/icop_staging
JWT_SECRET=REPLACE_RANDOM_HEX_64_OR_MORE
SECRETS_MASTER_KEY=REPLACE_RANDOM_HEX_64
MFA_POLICY=privileged
JWT_TTL=8h
LOGIN_RATE_LIMIT=10
ALLOWED_ORIGINS=https://REPLACE_STAGING_FRONTEND_HOST
TRUST_PROXY=false
API_DOCS_ENABLED=false
RUN_SEED=false
ESIGN_SANDBOX_ENABLED=false
SCHEDULER_ENABLED=false
JOB_WORKER_ENABLED=false
DOC_MAX_MB=50
DOC_MAX_PAGES=300
OCR_LANGS=ind+eng
OCR_DPI=200
