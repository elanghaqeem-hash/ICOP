# TEMPLATE ONLY: copy to infra/hostinger/.env.production (chmod 600).
# DO NOT commit the populated file or reuse CI/development credentials.
# Replace every placeholder before running the Hostinger preflight.
ICOP_DOMAIN=REPLACE_WITH_REAL_DOMAIN
ACME_EMAIL=REPLACE_WITH_ADMIN_EMAIL

NODE_ENV=production
LOG_LEVEL=info
DB_HOST=postgres
DB_PORT=5432
DB_NAME=icop_production
DB_USER=icop_app
DB_PASSWORD=REPLACE_WITH_48PLUS_RANDOM_ALPHANUMERIC
# Must match DB_USER, DB_PASSWORD, DB_NAME above. URL-encode special characters.
DATABASE_URL=postgres://icop_app:REPLACE_WITH_48PLUS_RANDOM_ALPHANUMERIC@postgres:5432/icop_production
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_48
SECRETS_MASTER_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
JWT_TTL=8h
MFA_POLICY=privileged
LOGIN_RATE_LIMIT=10
ALLOWED_ORIGINS=https://REPLACE_WITH_REAL_DOMAIN
APP_PUBLIC_ORIGIN=https://REPLACE_WITH_REAL_DOMAIN
TRUST_PROXY=false
API_DOCS_ENABLED=false
RUN_SEED=false
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_MIN=15
JOB_WORKER_ENABLED=true
ESIGN_SANDBOX_ENABLED=false
DOC_MAX_MB=50
DOC_MAX_PAGES=300
OCR_LANGS=ind+eng
OCR_DPI=200
