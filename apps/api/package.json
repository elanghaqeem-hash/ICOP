{
  "name": "@icop/api",
  "version": "1.0.0",
  "description": "ICOP CyberBusiness 360 API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:seed": "tsx src/migrate.ts --seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "openapi": "tsx src/export-openapi.ts"
  },
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/jwt": "^8.0.1",
    "@fastify/multipart": "^8.3.1",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/swagger": "^8.15.0",
    "@fastify/swagger-ui": "^4.2.0",
    "bcryptjs": "^2.4.3",
    "docx": "^9.9.0",
    "dotenv": "^16.6.1",
    "fastify": "^4.29.1",
    "mammoth": "^1.13.0",
    "nodemailer": "^7.0.13",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "unpdf": "^0.12.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  }
}
