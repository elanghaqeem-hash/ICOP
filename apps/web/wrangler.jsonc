{
  "$schema": "node_modules/wrangler/config-schema.json",
  // This is the existing Cloudflare Worker name; do not rename it without
  // changing the matching Worker project in the dashboard.
  "name": "icop",
  // Generated by the OpenNext Cloudflare adapter, NOT by plain "next build".
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "icop"
    }
  ]
}
