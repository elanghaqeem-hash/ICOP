# ── ICOP CyberBusiness 360 — contoh environment (salin ke .env, JANGAN commit .env) ──
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000
# Aktifkan TRUST_PROXY hanya di belakang reverse proxy tepercaya; port API harus tetap private
TRUST_PROXY=false
# Swagger UI nonaktif secara default pada production
API_DOCS_ENABLED=false
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
JWT_TTL=8h
LOGIN_RATE_LIMIT=10
# Phase 5 Gate 4B: MFA di produksi wajib untuk admin, direktur, approval, finance, legal, tender.
# Nilai: privileged | all. Di development/test default off untuk fixture lama.
# MFA_POLICY=privileged (default otomatis saat NODE_ENV=production)
MFA_POLICY=privileged

DB_HOST=localhost
DB_PORT=5432
DB_NAME=icop
DB_USER=icop_app
DB_PASSWORD=ganti-password-db
# atau: DATABASE_URL=postgres://user:pass@host:5432/icop

# Password awal seluruh user seed (wajib diganti saat login pertama)
SEED_PASSWORD= # buat acak minimal 16 karakter, pakai Secret Manager untuk produksi

# Frontend BFF Next.js → API PRIVATE (server-side ONLY; tidak diekspos browser)
# Untuk Vercel, pakai endpoint HTTPS API atau private networking yang valid, JANGAN localhost.
API_INTERNAL_URL=http://localhost:3001
# Origin persis dari browser: skema + host + port; tanpa trailing slash.
# Wajib dikonfigurasi sesuai URL publik di staging/production (misalnya https://icop.example.com).
APP_PUBLIC_ORIGIN=http://localhost:3000
# Browser JWT disimpan dalam cookie httpOnly di BFF, bukan sessionStorage.
# Next server harus menerima APP_PUBLIC_ORIGIN dan API_INTERNAL_URL sebagai runtime secrets/config.

# ── AI providers (failover berurutan; kosongkan untuk melewati provider) ──
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Endpoint OpenAI-compatible lain (Ollama/vLLM/cloud lokal)
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
AI_TIMEOUT_MS=30000
# Override model (opsional) — verifikasi nama model ke dokumentasi provider
# AI_MODEL_ANTHROPIC=claude-sonnet-5-5
# AI_MODEL_OPENAI=gpt-4o-mini
# AI_MODEL_GEMINI=gemini-2.0-flash
# AI_MODEL_MISTRAL=mistral-small-latest
# AI_MODEL_GROQ=llama-3.3-70b-versatile
# AI_MODEL_OPENROUTER=openrouter/auto

# ── Phase 2 ──
UPLOAD_DIR=./storage/uploads     # dokumen tender (pindah ke MinIO/S3 terenkripsi sebelum produksi)
SCHEDULER_ENABLED=true           # eskalasi SLA & pengingat deadline tiap SCHEDULER_INTERVAL_MIN
SCHEDULER_INTERVAL_MIN=15

# ── Phase 2b: kunci AI terenkripsi & Document Center ──
# Kunci master AES-256-GCM untuk API key AI yang diregistrasi admin (wajib di production).
# Buat: openssl rand -hex 32 — simpan di secret manager; mengganti kunci = registrasi ulang semua API key.
SECRETS_MASTER_KEY=
DOCUMENT_DIR=./storage/uploads/documents
DOC_MAX_MB=50                    # batas ukuran unggah (MB)
DOC_MAX_PAGES=300                # batas jumlah halaman PDF
OCR_LANGS=ind+eng                # bahasa tesseract (dipotong ke yang terpasang)
OCR_DPI=200
DOC_AI_CHUNK_CHARS=12000         # analisis AI map-reduce per potongan
DOC_AI_MAX_CHUNKS=60
JOB_WORKER_ENABLED=true          # worker OCR/kompresi/analisis in-process; false bila worker dipisah

# ── Phase 3: e-sign ──
# Sandbox = simulator UAT, TIDAK mengikat hukum, otomatis diblokir saat NODE_ENV=production.
ESIGN_SANDBOX_ENABLED=true          # aktif di dev/UAT; set false untuk mematikan
ESIGN_SANDBOX_SECRET=
# VIDA / Privy, object storage S3/MinIO, feed tender, SMTP, dan API key ingest SOC/VAPT dikonfigurasi admin di aplikasi
# (Pengaturan → Email (SMTP) / Integrasi) dan disimpan terenkripsi dengan SECRETS_MASTER_KEY — bukan di file ini.

# ── Profil docker compose 'minio' (opsional) ──
MINIO_ROOT_USER=icop-minio
MINIO_ROOT_PASSWORD=

